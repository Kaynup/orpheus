# Doc-QA Assistant Configuration

# Choose default LLM provider & model
# Examples for LiteLLM:
#   - gemini/gemini-1.5-flash
#   - gemini/gemini-1.5-pro
#   - openrouter/google/gemini-flash-1.5
#   - openrouter/meta-llama/llama-3.1-8b-instruct
#   - ollama/gemma3:1b
#   - gpt-4o-mini
# Set to 'offline' to test pipeline without external LLM API keys
LLM_MODEL=gemini/gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Ollama Settings (Local execution - no API key needed)
OLLAMA_API_BASE=http://localhost:11434

# API Keys (Provide according to chosen provider)
# Gemini extra info
GSAPI_PROJECT_NUMBER=
GEMINI_MODEL=

GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# RAG Chunking Settings
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
# JSON array of string separators used for recursively splitting text
RAG_CHUNK_SEPARATORS='["\n\n", "\n", ". ", "? ", "! ", " ", ""]'

# RAG Retrieval Settings
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.85

# Ingestion Settings
# Comma-separated list of allowed file extensions (with or without leading dot)
RAG_ALLOWED_EXTENSIONS=.txt,.pdf
# Maximum file size in megabytes
RAG_MAX_FILE_SIZE_MB=10
# Read buffer size in bytes for SHA-256 checksum calculation
RAG_HASH_BUFFER_SIZE=65536

# Storage Settings
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=doc_qa_collection

# Web Server Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
MAX_CONTENT_LENGTH=16777216
SECRET_KEY=your-secret-key-for-sessions-change-me
LOG_LEVEL=INFO
