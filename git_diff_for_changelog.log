+{% extends "base.html" %}
+
+{% block content %}
+<div class="app-container">
+    {% include "partials/header.html" %}
+
+    <!-- Main Content Area -->
+    <main class="main-content">
+        {% include "partials/tab_chat.html" %}
+        {% include "partials/tab_ingestion.html" %}
+        {% include "partials/tab_evaluation.html" %}
+    </main>
+</div>
+
+{% include "partials/modal_inspector.html" %}
+{% endblock %}
