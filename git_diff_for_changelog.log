+++ b/app/static/css/components/chat.css
@@ -0,0 +1,221 @@
+/* ==========================================================================
+   Chat Layout & Components
+   ========================================================================== */
+
+.chat-layout {
+    display: grid;
+    grid-template-columns: 1fr 340px;
+    gap: 20px;
+}
+
+@media (max-width: 900px) {
+    .chat-layout {
+        grid-template-columns: 1fr;
+    }
+}
+
+.chat-main-panel {
+    display: flex;
+    flex-direction: column;
+    height: 640px;
+    background: var(--bg-surface);
+    border: 1px solid var(--border-color);
+    border-radius: var(--radius-md);
+    padding: 16px;
+    box-shadow: var(--shadow-soft);
+}
+
+/* Suggestions Chips */
+.suggestions-container {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    padding-bottom: 12px;
+    border-bottom: 1px solid var(--border-color-light);
+    margin-bottom: 12px;
+    flex-wrap: wrap;
+}
+
+.suggestions-label {
+    font-size: 11px;
+    font-weight: 600;
+    color: var(--text-muted);
+    text-transform: uppercase;
+    letter-spacing: 0.5px;
+}
+
+.suggestion-chips {
+    display: flex;
+    gap: 6px;
+    flex-wrap: wrap;
+}
+
+.chip {
+    background: var(--bg-surface-soft);
+    border: 1px solid var(--border-color);
+    font-size: 12px;
+    color: var(--text-main);
+    padding: 4px 10px;
+    border-radius: 14px;
+    cursor: pointer;
+    transition: all 0.15s ease;
+}
+
+.chip:hover {
+    background: var(--color-primary-soft);
+    border-color: var(--color-accent-sage);
+    color: var(--color-primary);
+}
+
+/* Chat Messages */
+.chat-messages-area {
+    flex: 1;
+    overflow-y: auto;
+    padding: 8px 4px 16px;
+    display: flex;
+    flex-direction: column;
+    gap: 16px;
+}
+
+.chat-message {
+    padding: 14px 18px;
+    border-radius: var(--radius-md);
+    max-width: 90%;
+}
+
+.user-message {
+    background: var(--color-primary-soft);
+    border: 1px solid #CFE0D6;
+    align-self: flex-end;
+}
+
+.bot-message {
+    background: var(--bg-surface-elevated);
+    border: 1px solid var(--border-color);
+    align-self: flex-start;
+    width: 100%;
+    max-width: 100%;
+}
+
+.message-header {
+    display: flex;
+    justify-content: space-between;
+    font-size: 11px;
+    color: var(--text-muted);
+    margin-bottom: 6px;
+}
+
+.message-sender {
+    font-weight: 600;
+    color: var(--color-primary);
+}
+
+.message-body {
+    font-size: 13.5px;
+    line-height: 1.6;
+    color: var(--text-main);
+}
+
+/* Citations & Badges */
+.citations-list {
+    margin-top: 12px;
+    padding-top: 10px;
+    border-top: 1px solid var(--border-color-light);
+    display: flex;
+    flex-wrap: wrap;
+    gap: 6px;
+    align-items: center;
+}
+
+.citations-label {
+    font-size: 11px;
+    font-weight: 600;
+    color: var(--text-muted);
+}
+
+.citation-pill {
+    background: var(--color-primary-soft);
+    border: 1px solid var(--color-accent-sage);
+    color: var(--color-primary-text);
+    font-size: 11px;
+    font-weight: 600;
+    padding: 3px 8px;
+    border-radius: var(--radius-sm);
+    cursor: pointer;
+}
+
+.citation-pill:hover {
+    background: #D1E5D8;
+}
+
+/* Message Drawers / Collapsibles */
+.message-actions-bar {
+    margin-top: 10px;
+    display: flex;
+    gap: 8px;
+}
+
+.btn-drawer-toggle {
+    font-size: 11px;
+    background: var(--bg-surface-soft);
+    border: 1px solid var(--border-color);
+    color: var(--text-muted);
+    padding: 4px 10px;
+    border-radius: var(--radius-sm);
+    cursor: pointer;
+}
+
+.btn-drawer-toggle:hover {
+    background: #E8E3D7;
+    color: var(--text-main);
+}
+
+/* Chat Input Form */
+.chat-input-form {
+    border-top: 1px solid var(--border-color);
+    padding-top: 12px;
+}
+
+.input-wrapper {
+    display: flex;
+    gap: 8px;
+}
+
+.input-wrapper input {
+    flex: 1;
+    padding: 10px 14px;
+    border: 1px solid var(--border-color);
+    border-radius: var(--radius-sm);
+    font-size: 13px;
+    background: var(--bg-surface-elevated);
+    color: var(--text-main);
+    outline: none;
+}
+
+.input-wrapper input:focus {
+    border-color: var(--color-accent-sage);
+    background: #FFFFFF;
+}
+
+.chat-controls-row {
+    display: flex;
+    gap: 16px;
+    margin-top: 8px;
+    font-size: 12px;
+    color: var(--text-muted);
+}
+
+.control-group {
+    display: flex;
+    align-items: center;
+    gap: 6px;
+}
+
+.control-group select {
+    padding: 4px 8px;
+    border: 1px solid var(--border-color);
+    border-radius: var(--radius-sm);
+    background: var(--bg-surface);
+    font-size: 12px;
+    color: var(--text-main);
+}
diff --git a/app/static/css/components/evaluation.css b/app/static/css/components/evaluation.css
new file mode 100644
index 0000000..29d90a6
--- /dev/null
+++ b/app/static/css/components/evaluation.css
@@ -0,0 +1,111 @@
+/* ==========================================================================
+   Evaluation Benchmark Layout & Tables
+   ========================================================================== */
+
+.eval-header-card {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    background: var(--bg-surface);
+    border: 1px solid var(--border-color);
+    border-radius: var(--radius-md);
+    padding: 20px;
+    box-shadow: var(--shadow-soft);
+    margin-bottom: 20px;
+    flex-wrap: wrap;
+    gap: 16px;
+}
+
+.eval-header-card h2 {
+    font-family: var(--font-heading);
+    font-size: 18px;
+    color: var(--color-primary);
+}
+
+.eval-header-card p {
+    font-size: 12px;
+    color: var(--text-muted);
+}
+
+.eval-summary-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+    gap: 14px;
+}
+
+.eval-stat-card {
+    background: var(--bg-surface);
+    border: 1px solid var(--border-color);
+    border-radius: var(--radius-md);
+    padding: 16px;
+    display: flex;
+    flex-direction: column;
+}
+
+.eval-stat-label {
+    font-size: 11px;
+    font-weight: 600;
+    color: var(--text-muted);
+    text-transform: uppercase;
+    letter-spacing: 0.5px;
+}
+
+.eval-stat-val {
+    font-family: var(--font-heading);
+    font-size: 22px;
+    font-weight: 700;
+    color: var(--color-primary);
+    margin-top: 4px;
+}
+
+/* Data Table */
+.table-responsive {
+    overflow-x: auto;
+}
+
+.data-table {
+    width: 100%;
+    border-collapse: collapse;
+    font-size: 12.5px;
+    margin-top: 12px;
+}
+
+.data-table th, .data-table td {
+    padding: 10px 12px;
+    border-bottom: 1px solid var(--border-color-light);
+    text-align: left;
+}
+
+.data-table th {
+    background: var(--bg-surface-soft);
+    font-weight: 600;
+    color: var(--text-muted);
+    font-size: 11.5px;
+    text-transform: uppercase;
+}
+
+.badge {
+    display: inline-block;
+    padding: 2px 8px;
+    border-radius: 4px;
+    font-size: 11px;
+    font-weight: 700;
+}
+
+.badge-success {
+    background: var(--status-success-bg);
+    color: var(--status-success-text);
+}
+
+.badge-fail {
+    background: var(--status-error-bg);
+    color: var(--status-error-text);
+}
+
+.text-center {
+    text-align: center;
+}
+
+.text-muted {
+    color: var(--text-muted);
+}
diff --git a/app/static/css/components/ingestion.css b/app/static/css/components/ingestion.css
new file mode 100644
index 0000000..83bd88b
--- /dev/null
+++ b/app/static/css/components/ingestion.css
@@ -0,0 +1,149 @@
+/* ==========================================================================
+   Document Ingestion Layout & Drag/Drop
+   ========================================================================== */
+
+.ingest-layout {
+    display: grid;
+    grid-template-columns: 420px 1fr;
+    gap: 20px;
+}
+
+@media (max-width: 900px) {
+    .ingest-layout {
+        grid-template-columns: 1fr;
+    }
+}
+
+.drop-zone {
+    border: 2px dashed var(--border-color);
+    border-radius: var(--radius-md);
+    background: var(--bg-surface-elevated);
+    padding: 30px 20px;
+    text-align: center;
+    cursor: pointer;
+    transition: all 0.2s ease;
+    margin-bottom: 14px;
+}
+
+.drop-zone:hover, .drop-zone.dragover {
+    border-color: var(--color-accent-sage);
+    background: var(--color-primary-soft);
+}
+
+.drop-icon {
+    font-size: 32px;
+    margin-bottom: 8px;
+}
+
+.drop-text {
+    font-size: 13px;
+    color: var(--text-main);
+    font-weight: 500;
+}
+
+.browse-link {
+    color: var(--color-primary);
+    text-decoration: underline;
+}
+
+.drop-hint {
+    display: block;
+    font-size: 11px;
+    color: var(--text-muted);
+    margin-top: 4px;
+}
+
+.selected-file-info {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    background: var(--color-primary-soft);
+    border: 1px solid #CFE0D6;
+    padding: 8px 12px;
+    border-radius: var(--radius-sm);
+    font-size: 12px;
+    font-weight: 600;
+    color: var(--color-primary-text);
+    margin-bottom: 14px;
+}
+
+.config-grid {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 12px;
+    margin-bottom: 16px;
+}
+
+.config-item label {
+    display: block;
+    font-size: 11px;
+    color: var(--text-muted);
+    margin-bottom: 4px;
+}
+
+.config-item input {
+    width: 100%;
+    padding: 8px 10px;
+    border: 1px solid var(--border-color);
+    border-radius: var(--radius-sm);
+    font-size: 13px;
+    background: var(--bg-surface-elevated);
+}
+
+/* Documents Table */
+.docs-header {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    margin-bottom: 16px;
+}
+
+.documents-list {
+    display: flex;
+    flex-direction: column;
+    gap: 10px;
+}
+
+.doc-card {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding: 12px 16px;
+    background: var(--bg-surface-elevated);
+    border: 1px solid var(--border-color-light);
+    border-radius: var(--radius-sm);
+}
+
+.doc-info {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+}
+
+.doc-icon, .doc-icon-badge {
+    font-size: 11px;
+    font-weight: 700;
+    color: var(--color-primary);
+    background: var(--color-primary-soft);
+    padding: 4px 8px;
+    border-radius: var(--radius-sm);
+    border: 1px solid var(--border-color);
+}
+
+.doc-name {
+    font-weight: 600;
+    font-size: 13px;
+    color: var(--color-primary-text);
+}
+
+.doc-meta {
+    font-size: 11px;
+    color: var(--text-muted);
+}
+
+.empty-state {
+    text-align: center;
+    padding: 40px 20px;
+    color: var(--text-muted);
+    font-size: 13px;
+}
diff --git a/app/static/css/components/inspector.css b/app/static/css/components/inspector.css
new file mode 100644
index 0000000..c21a2c4
--- /dev/null
+++ b/app/static/css/components/inspector.css
@@ -0,0 +1,171 @@
+/* ==========================================================================
+   Live Pipeline Observability Stepper & Diagnostic Metrics
+   ========================================================================== */
+
+.chat-inspector-panel {
+    background: var(--bg-surface);
+    border: 1px solid var(--border-color);
+    border-radius: var(--radius-md);
+    padding: 16px;
+    box-shadow: var(--shadow-soft);
+    display: flex;
+    flex-direction: column;
+}
+
+.inspector-header {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    margin-bottom: 4px;
+}
+
+.inspector-header h3 {
+    font-family: var(--font-heading);
+    font-size: 15px;
+    font-weight: 700;
+    color: var(--color-primary);
+}
+
+.live-tag {
+    font-size: 10px;
+    font-weight: 700;
+    text-transform: uppercase;
+    background: var(--color-primary-soft);
+    color: var(--color-primary);
+    padding: 2px 6px;
+    border-radius: 4px;
+}
+
+.inspector-desc {
+    font-size: 11.5px;
+    color: var(--text-muted);
+    margin-bottom: 16px;
+}
+
+.pipeline-stepper {
+    display: flex;
+    flex-direction: column;
+    gap: 12px;
+    position: relative;
+}
+
+.step-item {
+    display: flex;
+    gap: 12px;
+    position: relative;
+}
+
+.step-item::after {
+    content: '';
+    position: absolute;
+    top: 24px;
+    left: 11px;
+    width: 2px;
+    height: calc(100% - 12px);
+    background: var(--border-color-light);
+    z-index: 1;
+}
+
+.step-item:last-child::after {
+    display: none;
+}
+
+.step-icon {
+    width: 24px;
+    height: 24px;
+    border-radius: 50%;
+    background: var(--bg-surface-soft);
+    border: 1px solid var(--border-color);
+    color: var(--text-muted);
+    font-size: 11px;
+    font-weight: 700;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    position: relative;
+    z-index: 2;
+    transition: all 0.2s ease;
+}
+
+.step-content {
+    flex: 1;
+}
+
+.step-title {
+    font-size: 12.5px;
+    font-weight: 600;
+    color: var(--text-muted);
+}
+
+.step-details {
+    font-size: 11px;
+    color: var(--text-light);
+}
+
+/* Stepper States */
+.step-item.running .step-icon {
+    background: var(--status-running-bg);
+    border-color: var(--color-accent-sage);
+    color: var(--status-running-text);
+}
+
+.step-item.running .step-title {
+    color: var(--status-running-text);
+}
+
+.step-item.completed .step-icon {
+    background: var(--status-success-bg);
+    border-color: var(--color-primary);
+    color: var(--status-success-text);
+}
+
+.step-item.completed .step-title {
+    color: var(--color-primary);
+}
+
+.step-item.failed .step-icon {
+    background: var(--status-error-bg);
+    border-color: var(--color-accent-terracotta);
+    color: var(--status-error-text);
+}
+
+/* Diagnostic Metric Grid */
+.inspector-metrics {
+    margin-top: 20px;
+    padding-top: 14px;
+    border-top: 1px solid var(--border-color-light);
+}
+
+.inspector-metrics h4 {
+    font-size: 12px;
+    color: var(--text-muted);
+    text-transform: uppercase;
+    letter-spacing: 0.5px;
+    margin-bottom: 10px;
+}
+
+.metric-grid {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 8px;
+}
+
+.metric-card {
+    background: var(--bg-surface-soft);
+    padding: 8px 10px;
+    border-radius: var(--radius-sm);
+    display: flex;
+    flex-direction: column;
+}
+
+.metric-label {
+    font-size: 10.5px;
+    color: var(--text-muted);
+}
+
+.metric-val {
+    font-family: var(--font-mono);
+    font-size: 12px;
+    font-weight: 600;
+    color: var(--color-primary);
+}
diff --git a/app/static/css/components/modal.css b/app/static/css/components/modal.css
new file mode 100644
index 0000000..b331bab
--- /dev/null
+++ b/app/static/css/components/modal.css
@@ -0,0 +1,71 @@
+/* ==========================================================================
+   Modal Dialog & Backdrop Component
+   ========================================================================== */
+
+.modal-backdrop {
+    position: fixed;
+    top: 0;
+    left: 0;
+    width: 100vw;
+    height: 100vh;
+    background: rgba(29, 36, 33, 0.4);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    z-index: 1000;
+}
+
+.modal-card {
+    background: var(--bg-surface);
+    border-radius: var(--radius-md);
+    width: 90%;
+    max-width: 680px;
+    max-height: 80vh;
+    overflow-y: auto;
+    border: 1px solid var(--border-color);
+    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
+}
+
+.modal-header {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding: 16px 20px;
+    border-bottom: 1px solid var(--border-color);
+}
+
+.modal-header h3 {
+    font-family: var(--font-heading);
+    font-size: 16px;
+    font-weight: 700;
+    color: var(--color-primary);
+}
+
+.modal-body {
+    padding: 20px;
+    font-size: 13px;
+    line-height: 1.6;
+}
+
+.modal-body pre {
+    background: var(--bg-surface-soft);
+    padding: 14px;
+    border-radius: var(--radius-sm);
+    font-family: var(--font-mono);
+    font-size: 12px;
+    white-space: pre-wrap;
+    word-break: break-word;
+    border: 1px solid var(--border-color);
+}
+
+.btn-close-modal {
+    background: transparent;
+    border: none;
+    font-size: 16px;
+    cursor: pointer;
+    color: var(--text-muted);
+}
+
+.btn-close-modal:hover {
+    color: var(--text-main);
+}
diff --git a/app/static/css/layout.css b/app/static/css/layout.css
new file mode 100644
index 0000000..c67e6dc
--- /dev/null
+++ b/app/static/css/layout.css
@@ -0,0 +1,231 @@
+/* ==========================================================================
+   Layout & Common UI Structure
+   ========================================================================== */
+
+/* App Container */
+.app-container {
+    max-width: 1280px;
+    margin: 0 auto;
+    padding: 24px 20px 60px;
+}
+
+/* Header */
+.app-header {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding-bottom: 20px;
+    border-bottom: 1px solid var(--border-color);
+    margin-bottom: 20px;
+    flex-wrap: wrap;
+    gap: 16px;
+}
+
+.header-brand {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+}
+
+.brand-icon {
+    font-size: 28px;
+    background: var(--color-primary-soft);
+    width: 46px;
+    height: 46px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    border-radius: var(--radius-md);
+}
+
+.brand-title {
+    font-family: var(--font-heading);
+    font-size: 22px;
+    font-weight: 700;
+    color: var(--color-primary);
+    letter-spacing: -0.3px;
+    display: flex;
+    align-items: center;
+    gap: 8px;
+}
+
+.version-badge {
+    font-size: 11px;
+    font-weight: 600;
+    font-family: var(--font-mono);
+    color: var(--color-primary);
+    background: var(--color-primary-soft);
+    padding: 2px 7px;
+    border-radius: var(--radius-sm);
+    border: 1px solid var(--border-color);
+}
+
+.brand-subtitle {
+    font-size: 12px;
+    color: var(--text-muted);
+    margin-top: 2px;
+}
+
+.header-actions {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+}
+
+.status-indicator {
+    display: flex;
+    align-items: center;
+    gap: 6px;
+    font-size: 12px;
+    font-weight: 500;
+    color: var(--text-muted);
+    background: var(--bg-surface);
+    padding: 6px 12px;
+    border-radius: 20px;
+    border: 1px solid var(--border-color);
+}
+
+.pulse-dot {
+    width: 8px;
+    height: 8px;
+    border-radius: 50%;
+    background-color: var(--color-accent-sage);
+}
+
+/* Navigation Tabs */
+.nav-tabs {
+    display: flex;
+    gap: 8px;
+    margin-bottom: 24px;
+    border-bottom: 1px solid var(--border-color);
+    padding-bottom: 4px;
+}
+
+.nav-tab {
+    background: transparent;
+    border: none;
+    font-family: var(--font-heading);
+    font-size: 14px;
+    font-weight: 600;
+    color: var(--text-muted);
+    padding: 10px 18px;
+    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
+    cursor: pointer;
+    transition: all 0.15s ease;
+}
+
+.nav-tab:hover {
+    color: var(--color-primary);
+    background: var(--bg-surface-soft);
+}
+
+.nav-tab.active {
+    color: var(--color-primary);
+    background: var(--bg-surface);
+    border: 1px solid var(--border-color);
+    border-bottom: 2px solid var(--bg-surface);
+    margin-bottom: -5px;
+}
+
+/* Tab Panels */
+.tab-pane {
+    display: none;
+}
+
+.tab-pane.active {
+    display: block;
+}
+
+/* Buttons */
+.btn {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 6px;
+    font-family: var(--font-sans);
+    font-size: 13px;
+    font-weight: 600;
+    padding: 8px 16px;
+    border-radius: var(--radius-sm);
+    border: 1px solid transparent;
+    cursor: pointer;
+    transition: background 0.15s ease, border-color 0.15s ease;
+}
+
+.btn-primary {
+    background-color: var(--color-primary);
+    color: #FFFFFF;
+}
+
+.btn-primary:hover:not(:disabled) {
+    background-color: var(--color-primary-hover);
+}
+
+.btn-primary:disabled {
+    background-color: var(--border-color);
+    color: var(--text-light);
+    cursor: not-allowed;
+}
+
+.btn-secondary {
+    background-color: var(--bg-surface);
+    border-color: var(--border-color);
+    color: var(--text-main);
+}
+
+.btn-secondary:hover {
+    background-color: var(--bg-surface-soft);
+}
+
+.btn-outline-danger {
+    background-color: transparent;
+    border-color: var(--border-color);
+    color: var(--color-accent-terracotta);
+}
+
+.btn-outline-danger:hover {
+    background-color: var(--status-error-bg);
+}
+
+.btn-sm {
+    padding: 6px 12px;
+    font-size: 12px;
+}
+
+.btn-block {
+    width: 100%;
+}
+
+.btn-icon {
+    background: transparent;
+    border: none;
+    cursor: pointer;
+    color: var(--text-muted);
+}
+
+/* Cards & Panels */
+.panel-card {
+    background: var(--bg-surface);
+    border: 1px solid var(--border-color);
+    border-radius: var(--radius-md);
+    padding: 20px;
+    box-shadow: var(--shadow-soft);
+}
+
+.panel-card h3 {
+    font-family: var(--font-heading);
+    font-size: 16px;
+    font-weight: 700;
+    color: var(--color-primary);
+    margin-bottom: 4px;
+}
+
+.panel-subtitle {
+    font-size: 12px;
+    color: var(--text-muted);
+    margin-bottom: 16px;
+}
+
+.mt-4 {
+    margin-top: 16px;
+}
diff --git a/app/static/css/style.css b/app/static/css/style.css
