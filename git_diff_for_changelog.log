+<!-- TAB 2: Document Ingestion & Knowledge Base -->
+<section id="tab-ingest" class="tab-pane">
+    <div class="ingest-layout">
+        <!-- Left: Upload zone & chunk config -->
+        <div class="ingest-upload-panel">
+            <div class="panel-card">
+                <h3>Ingest Documents</h3>
+                <p class="panel-subtitle">Upload .txt or .pdf files to parse, chunk, embed, and store into
+                    ChromaDB.</p>
+
+                <form id="upload-form" class="upload-form">
+                    <div class="drop-zone" id="drop-zone">
+                        <div class="drop-icon">
+                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
+                                stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
+                                stroke-linejoin="round">
+                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
+                                <polyline points="17 8 12 3 7 8"></polyline>
+                                <line x1="12" y1="3" x2="12" y2="15"></line>
+                            </svg>
+                        </div>
+                        <p class="drop-text">Drag & drop files here, or <span
+                                class="browse-link">browse</span></p>
+                        <span class="drop-hint">Supported formats: .txt, .pdf (Max: 10MB)</span>
+                        <input type="file" id="file-input" accept=".txt,.pdf" style="display: none;">
+                    </div>
+
+                    <div id="selected-file-info" class="selected-file-info" style="display: none;">
+                        <span id="selected-file-name">filename.txt</span>
+                        <button type="button" id="btn-clear-file" class="btn-icon">✕</button>
+                    </div>
+
+                    <div class="config-grid">
+                        <div class="config-item">
+                            <label for="chunk-size-input">Chunk Size (chars):</label>
+                            <input type="number" id="chunk-size-input" value="500" min="100" max="2000"
+                                step="50">
+                        </div>
+                        <div class="config-item">
+                            <label for="chunk-overlap-input">Chunk Overlap (chars):</label>
+                            <input type="number" id="chunk-overlap-input" value="50" min="0" max="500"
+                                step="10">
+                        </div>
+                    </div>
+
+                    <button type="submit" id="btn-upload-submit" class="btn btn-primary btn-block" disabled>
+                        Start Ingestion Pipeline
+                    </button>
+                </form>
+            </div>
+
+            <!-- Live Ingestion Pipeline Stepper -->
+            <div class="panel-card mt-4" id="ingestion-stepper-card">
+                <h3>Ingestion Pipeline Stepper</h3>
+                <p class="panel-subtitle">Real-time backend progress during indexing.</p>
+
+                <div class="pipeline-stepper" id="ingest-stepper">
+                    <div class="step-item" id="istep-doc-received">
+                        <div class="step-icon">1</div>
+                        <div class="step-content">
+                            <div class="step-title">Document Received</div>
+                            <div class="step-details">Validation & file integrity</div>
+                        </div>
+                    </div>
+                    <div class="step-item" id="istep-text-extracted">
+                        <div class="step-icon">2</div>
+                        <div class="step-content">
+                            <div class="step-title">Text Extracted</div>
+                            <div class="step-details">Page-by-page extraction & checksum</div>
+                        </div>
+                    </div>
+                    <div class="step-item" id="istep-chunks-created">
+                        <div class="step-icon">3</div>
+                        <div class="step-content">
+                            <div class="step-title">Chunks Created</div>
+                            <div class="step-details">Boundary-aware recursive splitting</div>
+                        </div>
+                    </div>
+                    <div class="step-item" id="istep-embeddings-generated">
+                        <div class="step-icon">4</div>
+                        <div class="step-content">
+                            <div class="step-title">Embeddings Generated</div>
+                            <div class="step-details">Dense vector transformation (384-d)</div>
+                        </div>
+                    </div>
+                    <div class="step-item" id="istep-vectors-stored">
+                        <div class="step-icon">5</div>
+                        <div class="step-content">
+                            <div class="step-title">Vectors Stored</div>
+                            <div class="step-details">Persistent ChromaDB storage</div>
+                        </div>
+                    </div>
+                </div>
+            </div>
+        </div>
+
+        <!-- Right: Indexed Documents List -->
+        <div class="ingest-docs-panel">
+            <div class="panel-card">
+                <div class="docs-header">
+                    <div>
+                        <h3>Indexed Documents</h3>
+                        <p class="panel-subtitle">Knowledge base persisted in ChromaDB.</p>
+                    </div>
+                    <button id="btn-refresh-docs" class="btn btn-secondary btn-sm">Refresh</button>
+                </div>
+
+                <div id="documents-list-container" class="documents-list">
+                    <div class="empty-state">No documents indexed yet. Ingest a document or click 'Load
+                        Samples' above.</div>
+                </div>
+            </div>
+        </div>
+    </div>
+</section>
