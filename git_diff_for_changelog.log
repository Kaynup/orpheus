-
-.brand-subtitle {
-    font-size: 12px;
-    color: var(--text-muted);
-}
-
-.header-actions {
-    display: flex;
-    align-items: center;
-    gap: 12px;
-}
-
-.status-indicator {
-    display: flex;
-    align-items: center;
-    gap: 8px;
-    font-size: 12px;
-    font-weight: 500;
-    color: var(--text-muted);
-    background: var(--bg-surface);
-    border: 1px solid var(--border-color);
-    padding: 6px 12px;
-    border-radius: 20px;
-}
-
-.pulse-dot {
-    width: 8px;
-    height: 8px;
-    border-radius: 50%;
-    background-color: var(--color-accent-sage);
-}
-
-/* Navigation Tabs */
-.nav-tabs {
-    display: flex;
-    gap: 8px;
-    margin-bottom: 24px;
-    border-bottom: 1px solid var(--border-color);
-    padding-bottom: 4px;
-}
-
-.nav-tab {
-    background: transparent;
-    border: none;
-    font-family: var(--font-heading);
-    font-size: 14px;
-    font-weight: 600;
-    color: var(--text-muted);
-    padding: 10px 18px;
-    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
-    cursor: pointer;
-    transition: all 0.15s ease;
-}
-
-.nav-tab:hover {
-    color: var(--color-primary);
-    background: var(--bg-surface-soft);
-}
-
-.nav-tab.active {
-    color: var(--color-primary);
-    background: var(--bg-surface);
-    border: 1px solid var(--border-color);
-    border-bottom: 2px solid var(--bg-surface);
-    margin-bottom: -5px;
-}
-
-/* Tab Panels */
-.tab-pane {
-    display: none;
-}
-
-.tab-pane.active {
-    display: block;
-}
-
-/* Buttons */
-.btn {
-    display: inline-flex;
-    align-items: center;
-    justify-content: center;
-    gap: 6px;
-    font-family: var(--font-sans);
-    font-size: 13px;
-    font-weight: 600;
-    padding: 8px 16px;
-    border-radius: var(--radius-sm);
