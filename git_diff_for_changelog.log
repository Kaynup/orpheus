-
-.brand-title {
-    font-family: var(--font-heading);
-    font-size: 22px;
-    font-weight: 700;
-    color: var(--color-primary);
-    letter-spacing: -0.3px;
-    display: flex;
-    align-items: center;
-    gap: 8px;
-}
-
-.version-badge {
-    font-size: 11px;
-    font-weight: 600;
-    font-family: var(--font-mono);
-    color: var(--color-primary);
-    background: var(--color-primary-soft);
-    padding: 2px 7px;
-    border-radius: var(--radius-sm);
-    border: 1px solid var(--border-color);
